# =============================================================================
# ICC API Configuration (All ICC Backend URLs)
# =============================================================================
# ICC API base URL
ICC_API_BASE_URL=https://your-api-endpoint.com

# Job creation and execution endpoint
API_BASE_URL=https://your-api-endpoint.com/job/save

# Query execution endpoint
QUERY_API_BASE_URL=https://your-api-endpoint.com/utility/query

# Token endpoint for authentication
TOKEN_ENDPOINT=https://your-api-endpoint.com/token/gettoken

# Connection endpoints
ICC_CONNECTION_LIST_URL=https://your-api-endpoint.com/connection/list
ICC_SCHEMA_LIST_URL=https://your-api-endpoint.com/utility/connection
ICC_TABLE_LIST_URL=https://your-api-endpoint.com/utility/connection

# Table definition endpoint (for fetching table schemas)
TABLE_API_BASE_URL=https://your-api-endpoint.com/utility/table

# API timeout in seconds
API_TIMEOUT=30.0

# Base64 encoded username:password (e.g., echo -n "user:pass" | base64)
AUTH_USERPASS=

# Use mock data instead of real API calls (true/false)
TABLE_API_MOCK=false


# =============================================================================
# LLM Configuration (Ollama)
# =============================================================================
# Ollama base URL (local LLM server)
# OLLAMA_BASE_URL=http://localhost:11434

# Model for job agent (parameter extraction)
MODEL_NAME=qwen3:8b

# Model for SQL agent (SQL generation from natural language)
SQL_MODEL_NAME=qwen2.5-coder:7b


# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable logging of all prompts sent to LLMs (true/false)
ENABLE_PROMPT_LOGGING=false

# Directory where prompt logs will be saved
PROMPT_LOG_DIR=prompt_logs
